[Unit]
Description=rusno — self-hosted deployment manager
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# Change this to the user that should own rusno and have docker group access:
User=REPLACE_USER
Group=docker
ExecStart=/usr/local/bin/rusno serve --port 6967
Restart=on-failure
RestartSec=5
# Rusno home directory (config, db, keys, ssh). %h expands to the User's home.
Environment=RUSNO_HOME=%h/.rusno
WorkingDirectory=%h

# Hardening (deliberately no ProtectHome so host-existing SSH keys in ~/.ssh
# remain readable in host-existing mode).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=%h/.rusno %h/rusno/projects

[Install]
WantedBy=multi-user.target
